@WebApiWithMcp_HostAddress = https://localhost:7062
@WebApiWithMcp_ApiKey = 123456

// **
// Test the WeatherForecast endpoint with a zip code parameter
// **
GET {{WebApiWithMcp_HostAddress}}/weatherforecast/?zipCode=53150
Accept: application/json

###

// **
// Test the MCP initialize method
// **
POST {{WebApiWithMcp_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json
x-api-key: {{WebApiWithMcp_ApiKey}}

{
	"jsonrpc": "2.0",
	"method": "initialize",
	"id": 1
}

###

// **
// Test the MCP tools/list method
// **
POST {{WebApiWithMcp_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json
x-api-key: {{WebApiWithMcp_ApiKey}}

{
	"jsonrpc": "2.0",
	"method": "tools/list",
	"id": 1
}

###

// **
// Test the MCP tools/call method - Execute get_weather_forecast tool
// **
POST {{WebApiWithMcp_HostAddress}}/mcp
Accept: application/json, text/event-stream
Content-Type: application/json
x-api-key: {{WebApiWithMcp_ApiKey}}

{
	"jsonrpc": "2.0",
	"method": "tools/call",
	"params": {
		"name": "get_weather_forecast",
		"arguments": {
			"zipCode": "53150"
		}
	},
	"id": 1
}

###
